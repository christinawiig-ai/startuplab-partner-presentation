{
  "colors": {
    "primary": {
      "red": "#E5463A",
      "red-rgb": "229, 70, 58",
      "red-hover": "#D33328"
    },
    "neutral": {
      "dark": "#0B0F14",
      "dark-rgb": "11, 15, 20",
      "light": "#F5F7FA",
      "light-rgb": "245, 247, 250",
      "muted": "#9AA4B2",
      "muted-rgb": "154, 164, 178",
      "white": "#FFFFFF",
      "white-rgb": "255, 255, 255"
    },
    "semantic": {
      "background": "#FFFFFF",
      "surface": "#F5F7FA",
      "text-primary": "#0B0F14",
      "text-secondary": "#9AA4B2",
      "text-on-dark": "#FFFFFF",
      "border": "#E5E8EC",
      "accent-light": "#FFE5EA"
    }
  },
  "typography": {
    "fonts": {
      "ppt": {
        "primary": "Aptos",
        "fallback": "Calibri, sans-serif"
      },
      "html": {
        "primary": "Inter",
        "fallback": "system-ui, -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif"
      }
    },
    "sizes": {
      "hero": "72pt",
      "hero-px": "96px",
      "title": "48pt",
      "title-px": "64px",
      "section": "36pt",
      "section-px": "48px",
      "heading": "28pt",
      "heading-px": "37px",
      "subheading": "24pt",
      "subheading-px": "32px",
      "body-large": "20pt",
      "body-large-px": "27px",
      "body": "18pt",
      "body-px": "24px",
      "caption": "16pt",
      "caption-px": "21px",
      "small": "14pt",
      "small-px": "19px"
    },
    "weights": {
      "bold": 700,
      "semibold": 600,
      "medium": 500,
      "regular": 400,
      "light": 300
    },
    "lineHeights": {
      "tight": 1.1,
      "snug": 1.25,
      "normal": 1.5,
      "relaxed": 1.75,
      "loose": 2
    }
  },
  "spacing": {
    "xs": "8px",
    "sm": "16px",
    "md": "24px",
    "lg": "32px",
    "xl": "48px",
    "2xl": "64px",
    "3xl": "96px",
    "4xl": "128px",
    "section": "80px",
    "margin-min": "48px"
  },
  "layout": {
    "grid": {
      "columns": 12,
      "gap": "24px",
      "margin": "48px"
    },
    "maxWidth": {
      "content": "1280px",
      "text": "720px",
      "narrow": "540px"
    },
    "slides": {
      "ppt": {
        "width": "10in",
        "height": "5.625in",
        "ratio": "16:9"
      },
      "html": {
        "width": "100vw",
        "height": "100vh",
        "ratio": "16:9"
      }
    }
  },
  "borders": {
    "radius": {
      "none": "0",
      "sm": "4px",
      "md": "8px",
      "lg": "16px",
      "xl": "24px",
      "full": "9999px"
    },
    "width": {
      "thin": "1px",
      "medium": "2px",
      "thick": "4px"
    }
  },
  "shadows": {
    "none": "none",
    "sm": "0 1px 2px 0 rgba(11, 15, 20, 0.05)",
    "md": "0 4px 6px -1px rgba(11, 15, 20, 0.08), 0 2px 4px -1px rgba(11, 15, 20, 0.04)",
    "lg": "0 10px 15px -3px rgba(11, 15, 20, 0.1), 0 4px 6px -2px rgba(11, 15, 20, 0.05)",
    "xl": "0 20px 25px -5px rgba(11, 15, 20, 0.15), 0 10px 10px -5px rgba(11, 15, 20, 0.04)",
    "2xl": "0 25px 50px -12px rgba(11, 15, 20, 0.25)",
    "inner": "inset 0 2px 4px 0 rgba(11, 15, 20, 0.06)"
  },
  "animation": {
    "duration": {
      "fast": "150ms",
      "normal": "300ms",
      "slow": "500ms"
    },
    "easing": {
      "linear": "linear",
      "in": "cubic-bezier(0.4, 0, 1, 1)",
      "out": "cubic-bezier(0, 0, 0.2, 1)",
      "inOut": "cubic-bezier(0.4, 0, 0.2, 1)"
    }
  },
  "components": {
    "kpi": {
      "minTiles": 3,
      "maxTiles": 6,
      "tileMinWidth": "200px",
      "numberSize": "48px",
      "labelSize": "18px"
    },
    "quote": {
      "maxWidth": "720px",
      "fontSize": "28px",
      "authorSize": "18px",
      "quoteMarkSize": "64px"
    },
    "team": {
      "cardWidth": "240px",
      "photoSize": "120px",
      "nameSize": "20px",
      "roleSize": "16px"
    },
    "timeline": {
      "dotSize": "16px",
      "lineWidth": "2px",
      "cardWidth": "280px"
    }
  }
}